# ─── วิธีใช้ ────────────────────────────────────────────────────────────────────
# copy ไฟล์นี้เป็น .env.production แล้วแก้ค่า <...>
# Next.js โหลดไฟล์นี้อัตโนมัติเมื่อ NODE_ENV=production (พร้อมกับ .env)
#
# บน production server ต้องมีทั้งสองไฟล์:
#   .env              → POSTGRES_* สำหรับ Docker Compose
#   .env.production   → vars สาธารณะสำหรับ Next.js

# ─── WebSocket URL (แสดงผลฝั่ง browser) ────────────────────────────────────────
# ใช้ wss:// (secure websocket) ใน production
NEXT_PUBLIC_WS_URL=wss://todo.sfcinema.com/realtime

# ─── SF Cinema API ───────────────────────────────────────────────────────────────
# URL สำหรับ HR/Employee API (server-side only)
API_URL_USER=https://api.sfcinemacity.com/userapi

# ─── Email Configuration ───────────────────────────────────────────────────────
# SMTP relay (anonymous relay - no auth needed on internal network)
MAIL_HOST=mail.sfcinemacity.com
MAIL_PORT=25
MAIL_FROM=no-reply@sfcinema.com
MAIL_TIMEOUT=10000
# BCC recipients separated by semicolon (managers to receive copy of all emails)
MAIL_BCC=sittichai_c@sfcinema.com;thotsawat_sa@sfcinema.com;

# ─── Miscellaneous ───────────────────────────────────────────────────────────────
NEXT_TELEMETRY_DISABLED=1

# ─── TinyMCE Configuration ───────────────────────────────────────────────────────
NEXT_PUBLIC_TINYMCE_API_KEY=<your-tinymce-api-key>
