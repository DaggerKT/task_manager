# ─── วิธีใช้ ────────────────────────────────────────────────────────────────────
# copy ไฟล์นี้เป็น .env แล้วแก้ค่า <...>
#   docker compose up -d

# ─── Database (Docker Compose) ──────────────────────────────────────────────────
POSTGRES_DB=taskmanager
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<your-db-password>
DATABASE_URL=postgresql://postgres:<your-db-password>@localhost:5432/taskmanager

# ─── Email Configuration ───────────────────────────────────────────────────────
# SMTP relay (anonymous relay - no auth needed on internal network)
MAIL_HOST=<your-smtp-relay-host>
MAIL_PORT=25
MAIL_FROM=no-reply@<your-domain.com>
MAIL_TIMEOUT=10000
# BCC recipients separated by semicolon (managers to receive copy of all emails)
MAIL_BCC=sittichai_c@<your-domain.com>;thotsawat_sa@<your-domain.com>;

# ─── TinyMCE Configuration ───────────────────────────────────────────────────────
NEXT_PUBLIC_TINYMCE_API_KEY=<your-tinymce-api-key>
